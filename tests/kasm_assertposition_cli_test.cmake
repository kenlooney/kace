file(MAKE_DIRECTORY "${TEST_DIR}")
set(source "${TEST_DIR}/main.asm")
set(output "${TEST_DIR}/out.bin")
file(WRITE "${source}" "#assertposition 0\nbyte 1\n#include \"check.asm\"\nbyte 2\n#assertposition 0x2\n")
file(WRITE "${TEST_DIR}/check.asm" "#assertposition 1\n")
execute_process(COMMAND "${KASM}" -i "${source}" -o "${output}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Valid position assertion failed: ${error}")
endif()
file(READ "${output}" bytes HEX)
if(NOT bytes STREQUAL "0102")
  message(FATAL_ERROR "Position assertion changed the output: ${bytes}")
endif()

file(WRITE "${TEST_DIR}/check.asm" "#assertposition 2\n")
execute_process(COMMAND "${KASM}" -i "${source}" -o "${output}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "check.asm:1: Assert position failed: expected 2, got 1")
  message(FATAL_ERROR "Expected included position assertion failure: ${error}")
endif()
file(READ "${output}" bytes HEX)
if(NOT bytes STREQUAL "0102")
  message(FATAL_ERROR "Failed assertion changed the existing output: ${bytes}")
endif()

foreach(argument IN ITEMS "" "-1" "0x" "18446744073709551616")
  file(WRITE "${source}" "#assertposition ${argument}\n")
  execute_process(COMMAND "${KASM}" -i "${source}" -o "${output}" RESULT_VARIABLE result ERROR_VARIABLE error)
  if(result EQUAL 0)
    message(FATAL_ERROR "Invalid assertion argument was accepted: ${argument}")
  endif()
endforeach()
