file(MAKE_DIRECTORY "${TEST_DIR}/nested")
set(source "${TEST_DIR}/main.asm")
set(output "${TEST_DIR}/out.bin")
file(WRITE "${source}" "jmp short finish\n#include \"nested/first.asm\"\nfinish:\nnop\n")
file(WRITE "${TEST_DIR}/nested/first.asm" "byte 1\n#include 'second.asm'\nbyte 3\n")
file(WRITE "${TEST_DIR}/nested/second.asm" "byte 2\n")
execute_process(COMMAND "${KASM}" -i "${source}" -o "${output}"
                WORKING_DIRECTORY "${TEST_DIR}/nested" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Nested include failed: ${error}")
endif()
file(READ "${output}" bytes HEX)
if(NOT bytes STREQUAL "eb0301020390")
  message(FATAL_ERROR "Unexpected nested include output: ${bytes}")
endif()

file(WRITE "${TEST_DIR}/nested/second.asm" "#include \"../main.asm\"\n")
execute_process(COMMAND "${KASM}" -i "${source}" -o "${output}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "Include cycle")
  message(FATAL_ERROR "Expected include cycle error: ${error}")
endif()

file(WRITE "${TEST_DIR}/nested/second.asm" "#include \"missing.asm\"\n")
execute_process(COMMAND "${KASM}" -i "${source}" -o "${output}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "second.asm:1: Could not open include file")
  message(FATAL_ERROR "Expected missing include error with source location: ${error}")
endif()

file(WRITE "${TEST_DIR}/nested/second.asm" "byte 256\n")
execute_process(COMMAND "${KASM}" -i "${source}" -o "${output}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "second.asm:1: Byte value out of range")
  message(FATAL_ERROR "Expected included source diagnostic: ${error}")
endif()

file(WRITE "${source}" "#include \"unterminated\n")
execute_process(COMMAND "${KASM}" -i "${source}" -o "${output}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "quoted and not empty")
  message(FATAL_ERROR "Expected unterminated path error: ${error}")
endif()
