set(input "${TEST_DIR}/short_jump_input.asm")
set(output "${TEST_DIR}/short_jump_output.bin")

file(WRITE "${input}" "start:\njmp short done\nnop\ndone:\njmp short start\n")
execute_process(COMMAND "${KASM}" --cpu=x86 -i "${input}" -o "${output}"
  RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Short-jump assembly failed: ${error}")
endif()
file(READ "${output}" bytes HEX)
if(NOT bytes STREQUAL "eb0190ebfb")
  message(FATAL_ERROR "Expected EB 01 90 EB FB, got ${bytes}")
endif()
message(STATUS "Forward and backward jumps: EB 01 90 EB FB")

file(WRITE "${input}" "jmp short missing\n")
execute_process(COMMAND "${KASM}" --cpu=x86 -i "${input}" -o "${output}"
  RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES ":1: Unknown label: missing")
  message(FATAL_ERROR "Expected a line-specific unknown-label error: ${error}")
endif()
file(READ "${output}" bytes HEX)
if(NOT bytes STREQUAL "eb0190ebfb")
  message(FATAL_ERROR "Unknown label changed the output file")
endif()

string(REPEAT "nop\n" 128 padding)
file(WRITE "${input}" "jmp short faraway\n${padding}faraway:\n")
execute_process(COMMAND "${KASM}" --cpu=x86 -i "${input}" -o "${output}"
  RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES ":1: Jump displacement out of range")
  message(FATAL_ERROR "Expected a line-specific range error: ${error}")
endif()
file(READ "${output}" bytes HEX)
if(NOT bytes STREQUAL "eb0190ebfb")
  message(FATAL_ERROR "Out-of-range jump changed the output file")
endif()
message(STATUS "Unknown and out-of-range targets rejected")
file(WRITE "${input}" "start:\njmp near done\nnop\ndone:\njmp near start\n")
execute_process(COMMAND "${KASM}" --cpu=x86 -i "${input}" -o "${output}"
  RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Near-jump assembly failed: ${error}")
endif()
file(READ "${output}" bytes HEX)
if(NOT bytes STREQUAL "e9010090e9f9ff")
  message(FATAL_ERROR "Unexpected near-jump bytes: ${bytes}")
endif()
message(STATUS "Forward and backward near jumps: E9 01 00 90 E9 F9 FF")
file(WRITE "${input}" "same:\nnop\nsame:\n")
execute_process(COMMAND "${KASM}" --cpu=x86 -i "${input}" -o "${output}"
  RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES ":3: Duplicate label: same")
  message(FATAL_ERROR "Expected a duplicate-label error: ${error}")
endif()
file(REMOVE "${input}" "${output}" "${TEST_DIR}/short_jump_output.sym")
