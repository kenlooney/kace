file(MAKE_DIRECTORY "${TEST_DIR}")
set(source "${TEST_DIR}/halt.asm")
set(binary "${TEST_DIR}/halt.bin")
set(disassembly "${TEST_DIR}/halt.dism")
file(WRITE "${source}" "code16\nhlt\nhalt\ncode32\nhlt\ncode64\nhalt\n")
execute_process(COMMAND "${KASM}" -i "${source}" -o "${binary}"
  RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Halt assembly failed: ${error}")
endif()
file(READ "${binary}" bytes HEX)
if(NOT bytes STREQUAL "f4f4f4f4")
  message(FATAL_ERROR "Unexpected halt bytes: ${bytes}")
endif()
execute_process(COMMAND "${KASM}" -d -i "${binary}"
  RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Halt disassembly failed: ${error}")
endif()
file(READ "${disassembly}" decoded)
string(REGEX MATCHALL "\nhlt\n" instructions "${decoded}")
list(LENGTH instructions instruction_count)
if(NOT instruction_count EQUAL 4)
  message(FATAL_ERROR "Expected four halt instructions: ${decoded}")
endif()
execute_process(COMMAND "${KASM}" -i "${disassembly}" -o "${TEST_DIR}/roundtrip.bin"
  RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Halt reassembly failed: ${error}")
endif()
file(READ "${TEST_DIR}/roundtrip.bin" roundtrip HEX)
if(NOT roundtrip STREQUAL bytes)
  message(FATAL_ERROR "Halt round trip differs: ${roundtrip}")
endif()
foreach(invalid IN ITEMS "hlt 1" "halt 1")
  file(WRITE "${source}" "${invalid}\n")
  execute_process(COMMAND "${KASM}" -i "${source}" -o "${TEST_DIR}/invalid.bin"
    RESULT_VARIABLE result ERROR_VARIABLE error)
  if(result EQUAL 0)
    message(FATAL_ERROR "Invalid instruction was accepted: ${invalid}")
  endif()
endforeach()
