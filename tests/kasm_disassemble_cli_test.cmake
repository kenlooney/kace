set(source "${TEST_DIR}/disassembly_source.asm")
set(input "${TEST_DIR}/disassembly_input.bin")
set(default_output "${TEST_DIR}/disassembly_input.dism")
set(custom_base "${TEST_DIR}/disassembly_custom.bin")
set(custom_output "${TEST_DIR}/disassembly_custom.dism")
set(symbols "${TEST_DIR}/disassembly_input.sym")

file(WRITE "${source}" "start:\njmp short done\nnop\ndone:\njmp short start\n")
execute_process(COMMAND "${KASM}" -i "${source}" -o "${input}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Could not create test input: ${error}")
endif()
file(READ "${symbols}" symbol_data)
if(NOT symbol_data MATCHES "start 0 0" OR NOT symbol_data MATCHES "done 0 3")
  message(FATAL_ERROR "Expected saved label offsets: ${symbol_data}")
endif()
foreach(option IN ITEMS "-d" "--disassemble")
  execute_process(COMMAND "${KASM}" "${option}" --cpu=x86 -i "${input}" RESULT_VARIABLE result ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Disassembly failed: ${error}")
  endif()
  file(READ "${default_output}" decoded)
  if(NOT decoded STREQUAL "start:\njmp short done\nnop\ndone:\njmp short start\n")
    message(FATAL_ERROR "Unexpected disassembly: ${decoded}")
  endif()
endforeach()
execute_process(COMMAND "${KASM}" -d -i "${input}" -o "${custom_base}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT EXISTS "${custom_output}")
  message(FATAL_ERROR "Custom output name failed: ${error}")
endif()
file(READ "${custom_output}" decoded)
if(NOT decoded STREQUAL "start:\njmp short done\nnop\ndone:\njmp short start\n")
  message(FATAL_ERROR "Unexpected custom disassembly: ${decoded}")
endif()
execute_process(COMMAND "${KASM}" -i "${default_output}" -o "${TEST_DIR}/disassembly_roundtrip.bin" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Could not reassemble disassembly: ${error}")
endif()
file(READ "${TEST_DIR}/disassembly_roundtrip.bin" roundtrip HEX)
if(NOT roundtrip STREQUAL "eb0190ebfb")
  message(FATAL_ERROR "Reassembled bytes differ: ${roundtrip}")
endif()
file(WRITE "${symbols}" "broken 0\n")
execute_process(COMMAND "${KASM}" -d -i "${input}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "could not load symbol file")
  message(FATAL_ERROR "Expected invalid symbol-file error: ${error}")
endif()
file(READ "${default_output}" decoded)
if(NOT decoded STREQUAL "start:\njmp short done\nnop\ndone:\njmp short start\n")
  message(FATAL_ERROR "Invalid symbol file changed the disassembly")
endif()
file(REMOVE "${symbols}")
execute_process(COMMAND "${KASM}" -d -i "${input}" RESULT_VARIABLE result ERROR_VARIABLE error)
file(READ "${default_output}" decoded)
if(NOT result EQUAL 0 OR NOT decoded STREQUAL "jmp 1\nnop\njmp -5\n")
  message(FATAL_ERROR "Disassembly without symbols failed: ${error} ${decoded}")
endif()

file(WRITE "${source}" "define byte 235\n")
execute_process(COMMAND "${KASM}" -i "${source}" -o "${input}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Could not create incomplete instruction: ${error}")
endif()
execute_process(COMMAND "${KASM}" -d -i "${input}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "byte offset 0")
  message(FATAL_ERROR "Expected incomplete instruction error: ${error}")
endif()
file(READ "${default_output}" decoded)
if(NOT decoded STREQUAL "jmp 1\nnop\njmp -5\n")
  message(FATAL_ERROR "Failed decoding changed the output file")
endif()
execute_process(COMMAND "${KASM}" -d RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "input file is required")
  message(FATAL_ERROR "Expected a missing-input error: ${error}")
endif()
execute_process(COMMAND "${KASM}" -d --cpu=unknown -i "${input}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "could not load CPU plugin")
  message(FATAL_ERROR "Expected a missing-plugin error: ${error}")
endif()
message(STATUS "Disassembly naming, decoding, and error handling passed")
file(REMOVE "${source}" "${input}" "${symbols}" "${default_output}" "${custom_output}"
  "${TEST_DIR}/disassembly_roundtrip.bin" "${TEST_DIR}/disassembly_roundtrip.sym")
