set(input "${TEST_DIR}/cpu_cli_input.asm")
set(output "${TEST_DIR}/cpu_cli_output.bin")
file(WRITE "${input}" "start:\nnop\nmiddle:\ndefine byte 42\ndefine_byte 7\nnop\nend:\n")
foreach(cpu_option IN ITEMS "--cpu=x86" "-c;x86" "")
  execute_process(COMMAND "${KASM}" ${cpu_option} -i "${input}" -o "${output}"
    WORKING_DIRECTORY "${TEST_DIR}" RESULT_VARIABLE result ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Encoding failed (${cpu_option}): ${error}")
  endif()
  file(READ "${output}" bytes HEX)
  if(NOT bytes STREQUAL "902a0790")
    message(FATAL_ERROR "Unexpected encoded bytes: ${bytes}")
  endif()
endforeach()

foreach(invalid IN ITEMS "nop 1" "unknown" "db" "define byte 256")
  file(WRITE "${input}" "${invalid}\n")
  execute_process(COMMAND "${KASM}" --cpu=x86 -i "${input}" -o "${output}"
    RESULT_VARIABLE result ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT error MATCHES ":1:")
    message(FATAL_ERROR "Expected a line-specific error for '${invalid}': ${error}")
  endif()
  file(READ "${output}" bytes HEX)
  if(NOT bytes STREQUAL "902a0790")
    message(FATAL_ERROR "Failed encoding changed the output file")
  endif()
endforeach()
execute_process(COMMAND "${KASM}" --cpu=unknown -i "${input}" -o "${output}"
  RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "could not load CPU plugin 'unknown'")
  message(FATAL_ERROR "Expected a missing CPU plugin error: ${error}")
endif()
file(REMOVE "${input}" "${output}")
