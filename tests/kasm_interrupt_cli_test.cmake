file(MAKE_DIRECTORY "${TEST_DIR}")
set(source "${TEST_DIR}/interrupt.asm")
set(binary "${TEST_DIR}/interrupt.bin")
set(disassembly "${TEST_DIR}/interrupt.dism")
file(WRITE "${source}" "int 0\ninterrupt 0x21\nint 255\n")
execute_process(COMMAND "${KASM}" -i "${source}" -o "${binary}"
  RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Interrupt assembly failed: ${error}")
endif()
file(READ "${binary}" bytes HEX)
if(NOT bytes STREQUAL "cd00cd21cdff")
  message(FATAL_ERROR "Unexpected interrupt bytes: ${bytes}")
endif()
execute_process(COMMAND "${KASM}" -d -i "${binary}"
  RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Interrupt disassembly failed: ${error}")
endif()
file(READ "${disassembly}" decoded)
foreach(text IN ITEMS "int 0" "int 33" "int 255")
  string(FIND "${decoded}" "${text}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Missing ${text} in disassembly: ${decoded}")
  endif()
endforeach()
execute_process(COMMAND "${KASM}" -i "${disassembly}" -o "${TEST_DIR}/roundtrip.bin"
  RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Interrupt reassembly failed: ${error}")
endif()
file(READ "${TEST_DIR}/roundtrip.bin" roundtrip HEX)
if(NOT roundtrip STREQUAL bytes)
  message(FATAL_ERROR "Interrupt round trip differs: ${roundtrip}")
endif()
foreach(value IN ITEMS "256" "0x100" "invalid")
  file(WRITE "${source}" "int ${value}\n")
  execute_process(COMMAND "${KASM}" -i "${source}" -o "${TEST_DIR}/invalid.bin"
    RESULT_VARIABLE result ERROR_VARIABLE error)
  if(result EQUAL 0)
    message(FATAL_ERROR "Invalid interrupt ${value} was accepted")
  endif()
endforeach()
